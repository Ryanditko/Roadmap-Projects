{
  // Lenient config: this repo is prose-heavy learning material, not code docs.
  // We enforce structural correctness, not line width or inline-HTML bans.
  "default": true,
  "MD013": false, // line length — briefs use long descriptive sentences
  "MD033": false, // inline HTML — allowed in templates and callouts
  "MD041": false, // first line H1 — track pages open with a banner image
  "MD025": false, // multiple H1 — bilingual single-file docs have EN + PT titles
  "MD026": false, // trailing punctuation in headings
  "MD036": false, // emphasis used as heading — used intentionally in callouts
  "MD024": { "siblings_only": true }, // repeated headings ok if under different parents
  "MD029": { "style": "ordered" },

  // --- Relaxed while legacy briefs are being rewritten in the enrichment pass ---
  // These will be re-tightened in the final polish PR once every file has been
  // regenerated with clean spacing. Tracked in the CHANGELOG / final-polish task.
  "MD022": false, // blanks around headings
  "MD032": false, // blanks around lists
  "MD040": false, // fenced code language
  "MD047": false, // single trailing newline
  "MD009": false  // trailing spaces
}
